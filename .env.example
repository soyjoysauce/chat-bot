# Supabase credentials
# 1. Go to https://app.supabase.com → your project → Settings → API
# 2. Copy "Project URL" and "anon public" key
# 3. cp .env.example .env.local and fill in the values below

REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Workspace domain allowed to sign in (see README "Authentication Setup")
REACT_APP_ALLOWED_EMAIL_DOMAIN=doctorgenius.com
